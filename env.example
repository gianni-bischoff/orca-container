# Orca server stack - copy to .env and fill in your values.
# `.env` is gitignored and must never be committed: it holds credentials.

# --- Orca -------------------------------------------------------------------
# Address Orca clients should dial (host LAN IP, Tailscale/NetBird IP, or a
# full reverse-proxy URL such as https://orca.example.com/runtime).
# Never 127.0.0.1. Leave empty to let Orca pick its own advertised address.
#ORCA_PAIRING_ADDRESS=
#ORCA_PORT=6768
#ORCA_MOBILE_PAIRING=0

# --- NetBird agent peer -----------------------------------------------------
# Setup key from your NetBird dashboard (Setup Keys -> Add setup key).
# Required to register this container as a peer; peer identity is persisted
# in the netbird_state volume, so the key is only needed for first registration.
NETBIRD_ENABLED=0
NETBIRD_SETUP_KEY=
NETBIRD_MANAGEMENT_URL=https://netbird.wildblood.dev
# Peer name in the NetBird dashboard (defaults to container hostname orca-server)
#NETBIRD_PEER_NAME=orca-server
# Keep NetBird from rewriting /etc/resolv.conf inside the container (default 1)
#NETBIRD_DISABLE_DNS=1
# Extra flags for `netbird up`, e.g. --allow-server-ssh
#NETBIRD_EXTRA_UP_FLAGS=

# --- Build pinning ----------------------------------------------------------
#ORCA_VERSION=latest
#NETBIRD_VERSION=0.79.0